{
  "name": "dotnet-maui-10",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "runArgs": [
    "--userns=keep-id"
  ],
  "containerEnv": {
    "ANDROID_SDK_ROOT": "/home/vscode/.android/sdk",
    "ANDROID_HOME": "/home/vscode/.android/sdk"
  },
  "remoteEnv": {
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-21-amd64",
    "PATH": "${containerEnv:PATH}:/home/vscode/.android/sdk/cmdline-tools/latest/bin:/home/vscode/.android/sdk/platform-tools:/home/vscode/.android/sdk/emulator:/usr/lib/jvm/msopenjdk-21-amd64/bin"
  },
  "mounts": [
    "source=${localEnv:HOME}/.android/sdk,target=/home/vscode/.android/sdk,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.dotnet-maui",
        "ms-dotnettools.vscode-dotnet-runtime",
        "patcx.vscode-nuget-gallery"
      ],
      "settings": {
        "dotnet.defaultSolution": "*.sln",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    5555
  ],
  "portsAttributes": {
    "5555": {
      "label": "ADB WiFi",
      "onAutoForward": "silent"
    }
  }
}